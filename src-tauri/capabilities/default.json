{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum permissions for the Eclyzer Bridge main window. Only the APIs the UI actually calls are granted; there is no generic filesystem or shell permission.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:event:default",
    "dialog:allow-open",
    "opener:allow-open-url",
    "opener:allow-open-path",
    "process:allow-restart",
    "updater:default"
  ]
}
