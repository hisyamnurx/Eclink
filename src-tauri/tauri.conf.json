{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eclyzer Bridge",
  "version": "0.1.0",
  "identifier": "com.eclyzer.bridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Eclyzer Bridge",
        "width": 1060,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0a0a0b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Eclyzer Bridge contributors",
    "copyright": "Eclyzer Bridge contributors. MIT licensed. Not affiliated with OpenAI or Anthropic.",
    "category": "DeveloperTool",
    "shortDescription": "Switch AI providers for coding agents without editing config files.",
    "longDescription": "Eclyzer Bridge is a lightweight provider and profile manager for AI coding agents. It configures custom OpenAI-compatible endpoints for OpenAI Codex and Claude Code, tests them, and can safely restore your previous configuration. Eclyzer Bridge is an independent open-source project and is not affiliated with, endorsed by, or sponsored by OpenAI or Anthropic.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/eclyzer-bridge-helper.exe": "eclyzer-bridge-helper.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyNUJEQUZFNkY2NDM1RTUKUldUbE5XUnYvdHBiZ3MxeFdaM2J1MWhaZ3hFazQrNVdCUFAxRlUzdGN0a3huQVVBZjVPbmtaN1IK",
      "endpoints": [
        "https://github.com/hisyamnurx/Eclyzer-Bridge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
