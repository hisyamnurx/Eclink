# --- Eclyzer Bridge ---
# Never commit secrets, signing keys, local data or build output.

# Secrets / credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets.dat
secret*.json

# Tauri updater signing keys (generated by `tauri signer generate`)
*.key
*.key.pub
eclyzer-bridge-updater.*
tauri-signing-*

# Local application data that must never be committed
app.json
profiles.json
backups/
logs/
cache/

# Node
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Frontend build output
dist/
dist-ssr/
*.local
.vite/

# Rust / Tauri build output
target/
**/target/
src-tauri/target/
gen/schemas/

# Test / coverage
coverage/
*.lcov
test-results/
playwright-report/

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Local scratch
/tmp/
*.tmp
*.log
!.github/**/*.yml

# Scratch file used to pass a multi-line commit message to git
commitmsg.txt

cmsg.txt
cmsg2.txt
